{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "NOVA_WRAP_RENDER_MODES": "ON" }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows" }
    },
    {
      "name": "windows-vs2022-nowrap",
      "displayName": "Windows x64 (Visual Studio 2022), without wrap render modes",
      "description": "NOVA_WRAP_RENDER_MODES=OFF: each object drawn once, at its copy nearest the camera.",
      "inherits": "windows-vs2022",
      "binaryDir": "${sourceDir}/build-nowrap",
      "cacheVariables": { "NOVA_WRAP_RENDER_MODES": "OFF" }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config (Linux / Windows dev prompt)",
      "inherits": "base",
      "generator": "Ninja Multi-Config"
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "windows-vs2022", "configuration": "Debug" },
    { "name": "release", "configurePreset": "windows-vs2022", "configuration": "Release" },
    { "name": "nowrap-debug", "configurePreset": "windows-vs2022-nowrap", "configuration": "Debug" },
    { "name": "ninja-debug",   "configurePreset": "ninja", "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "windows-vs2022", "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "windows-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "nowrap-debug", "configurePreset": "windows-vs2022-nowrap", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
