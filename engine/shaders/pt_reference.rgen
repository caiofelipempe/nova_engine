#version 460
// Reference path tracer (DebugView::PathTraced). Each launch adds one path per pixel to a running
// average (pc.sampleIndex paths so far):
//  - the path starts at a random point of the pixel and bounces up to pc.bounces times;
//  - at every hit, the sun and the point lights are sampled directly (a shadow ray each), and the
//    next direction is drawn from the BRDF: the GGX specular lobe or the cosine diffuse one, chosen
//    by the Fresnel reflectance;
//  - paths that escape see the sky (its sun disc only from the camera: bounced paths already
//    sampled the sun directly; as light, scaled by the ambient intensity like the rasterized
//    ambient); emissive surfaces add their light where the path meets them;
//  - after the second bounce, Russian roulette ends weak paths without bias.
#include "nova/raytracing.glsl"
#include "nova/brdf.glsl"
#include "nova/sky.glsl"

// The accumulation image (32-bit floats), the same bindless storage-image array as g_images.
layout(set = 0, binding = 1, rgba32f) uniform image2D g_accumulation[];

layout(location = 0) rayPayloadEXT NovaSurfacePayload surface;
layout(location = 1) rayPayloadEXT float lightVisible;

uint pcg(inout uint state) {
    state = state * 747796405u + 2891336453u;
    const uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float random(inout uint state) { return float(pcg(state)) * (1.0 / 4294967296.0); }

float visibility(vec3 origin, vec3 dir, float tMax) {
    lightVisible = 0.0;
    traceRayEXT(accelerationStructureEXT(pc.tlas),
                gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT, 0xFF, NOVA_RAY_SHADOW,
                NOVA_RAY_TYPES, NOVA_RAY_SHADOW, origin, 0.0, dir, tMax, 1);
    return lightVisible;
}

// An orthonormal frame around n (Duff et al.).
void basis(vec3 n, out vec3 t, out vec3 b) {
    const float s = n.z >= 0.0 ? 1.0 : -1.0;
    const float a = -1.0 / (s + n.z), c = n.x * n.y * a;
    t = vec3(1.0 + s * n.x * n.x * a, s * c, -s * n.x);
    b = vec3(c, s + n.y * n.y * a, -n.y);
}

float maxComponent(vec3 v) { return max(v.x, max(v.y, v.z)); }

void main() {
    const ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    uint seed = (uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + pc.sampleIndex * 26699u) | 1u;
    pcg(seed);

    // A random point of the pixel, without the frame's TAA jitter (viewProj includes it).
    const vec2 point = vec2(pixel) + vec2(random(seed), random(seed));
    const vec2 ndc = point / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0 + pc.frame.data.jitter.xy;
    const vec4 far = pc.frame.data.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 origin = pc.frame.data.cameraPos.xyz;
    vec3 dir = normalize(far.xyz / far.w - origin);

    vec3 radiance = vec3(0.0), throughput = vec3(1.0);
    const vec3 sunDir = -normalize(pc.frame.data.sunDirection.xyz);
    const vec3 sunRadiance = pc.frame.data.sunColor.rgb * pc.frame.data.sunDirection.w;
    for (uint bounce = 0u; bounce <= pc.bounces; ++bounce) {
        surface.hitT = -1.0;
        traceRayEXT(accelerationStructureEXT(pc.tlas), gl_RayFlagsNoneEXT, 0xFF, NOVA_RAY_PRIMARY, NOVA_RAY_TYPES,
                    NOVA_RAY_PRIMARY, origin, 0.0, dir, 1e5, 0);
        if (surface.hitT < 0.0) {
            // Seen from the camera, the sky as it is; as light (bounced paths), scaled by the
            // ambient intensity, as the rasterized hemisphere ambient is.
            const float skyLight = bounce == 0u ? 1.0 : pc.frame.data.skyZenith.w;
            radiance += throughput * nova_skyRadiance(pc.frame, dir, bounce == 0u) * skyLight;
            break;
        }
        const vec3 P = surface.position, N = surface.normal, V = -dir;
        const vec3 albedo = surface.albedo;
        const float metallic = surface.metallic, roughness = surface.roughness;
        radiance += throughput * surface.emissive;
        const vec3 lightOrigin = P + N * pc.bias;

        // The lights, sampled directly.
        if (dot(N, sunDir) > 0.0)
            radiance += throughput * nova_brdf(N, V, sunDir, albedo, metallic, roughness) * sunRadiance *
                        visibility(lightOrigin, sunDir, 1e5);
        const uint count = min(pc.frame.data.pointLightCount, uint(MAX_POINT_LIGHTS));
        for (uint i = 0u; i < count; ++i) {
            const PointLight light = pc.frame.data.pointLights[i];
            const vec3 toLight = light.positionRadius.xyz - P;
            const float dist = length(toLight), radius = light.positionRadius.w;
            if (dist >= radius) continue;
            const vec3 L = toLight / dist;
            if (dot(N, L) <= 0.0) continue;
            const float window = clamp(1.0 - pow(dist / radius, 4.0), 0.0, 1.0);
            const float atten = window * window / (dist * dist + 1.0);
            const int slot = pc.frame.data.pointShadowSlots[i >> 2u][i & 3u];
            const float shadow = slot == -2 ? 1.0 : visibility(lightOrigin, L, max(dist - pc.bias, 0.0));
            radiance += throughput * nova_brdf(N, V, L, albedo, metallic, roughness) * light.colorIntensity.rgb *
                        light.colorIntensity.w * atten * shadow;
        }
        if (bounce == pc.bounces) break;

        // The next direction, from the BRDF.
        const float NdotV = max(dot(N, V), 1e-4);
        const vec3 F0 = mix(vec3(0.04), albedo, metallic);
        const vec3 Fv = nova_F_Schlick(NdotV, F0);
        const float specularChance = clamp(maxComponent(Fv), 0.1, 0.9);
        vec3 T, B;
        basis(N, T, B);
        vec3 L;
        vec3 weight;
        if (random(seed) < specularChance) { // GGX: a half vector from D(h)·cos, mirrored
            const float a = max(roughness * roughness, 0.002), a2 = a * a;
            const float u1 = random(seed), u2 = random(seed);
            const float phi = 6.2831853 * u1;
            const float cosTheta = sqrt((1.0 - u2) / (1.0 + (a2 - 1.0) * u2));
            const float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
            const vec3 H = normalize(T * (cos(phi) * sinTheta) + B * (sin(phi) * sinTheta) + N * cosTheta);
            L = reflect(-V, H);
            const float NdotL = dot(N, L);
            if (NdotL <= 0.0) break;
            const float NdotH = max(dot(N, H), 1e-4), VdotH = max(dot(V, H), 1e-4);
            const float k = (roughness + 1.0) * (roughness + 1.0) / 8.0;
            const float G = nova_G_SchlickGGX(NdotV, k) * nova_G_SchlickGGX(NdotL, k);
            weight = nova_F_Schlick(VdotH, F0) * G * VdotH / (NdotH * NdotV) / specularChance;
        } else { // diffuse: cosine-weighted (the cosine and 1/π cancel with the density)
            const float u1 = random(seed), u2 = random(seed);
            const float r = sqrt(u1), phi = 6.2831853 * u2;
            L = normalize(T * (r * cos(phi)) + B * (r * sin(phi)) + N * sqrt(max(1.0 - u1, 0.0)));
            weight = albedo * (1.0 - metallic) * (1.0 - Fv) / (1.0 - specularChance);
        }
        throughput *= weight;
        if (bounce >= 2u) { // Russian roulette
            const float keep = clamp(maxComponent(throughput), 0.05, 0.95);
            if (random(seed) > keep) break;
            throughput /= keep;
        }
        origin = lightOrigin;
        dir = L;
    }

    // Fireflies (rare paths of huge weight) clamped, NaNs dropped, then into the running average.
    if (any(isnan(radiance)) || any(isinf(radiance))) radiance = vec3(0.0);
    radiance = min(radiance, vec3(64.0));
    const ivec2 at = pixel;
    vec3 average = radiance;
    if (pc.sampleIndex > 0u) {
        const vec3 previous = imageLoad(g_accumulation[nonuniformEXT(pc.outputImage)], at).rgb;
        average = previous + (radiance - previous) / float(pc.sampleIndex + 1u);
    }
    imageStore(g_accumulation[nonuniformEXT(pc.outputImage)], at, vec4(average, 1.0));
}
