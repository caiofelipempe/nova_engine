#version 460
// Skinned meshes for ray tracing: writes the deformed vertices of one draw into a buffer of its own
// (the vertex layout, so its BLAS can be refitted from it), the same math as forward.vert.
#include "nova/common.glsl"

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer DeformedBuffer { Vertex items[]; };

layout(push_constant) uniform SkinPush {
    VertexBuffer source;   // the mesh's vertices (bind pose)
    SkinBuffer skin;       // its joints and weights
    JointBuffer joints;    // the draw's joint matrices (mesh space)
    DeformedBuffer target; // the deformed vertices
    uint count;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    Vertex v = pc.source.items[i];
    const SkinVertex s = pc.skin.items[i];
    const uint j[4] = uint[4](s.joints.x & 0xFFFFu, s.joints.x >> 16, s.joints.y & 0xFFFFu, s.joints.y >> 16);
    mat4 m = mat4(0.0);
    for (int k = 0; k < 4; ++k) m += s.weights[k] * pc.joints.items[j[k]];
    v.position = (m * vec4(v.position, 1.0)).xyz;
    v.normal = normalize(mat3(m) * v.normal);
    pc.target.items[i] = v;
}
